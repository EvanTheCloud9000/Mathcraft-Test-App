# Copy to .env for local development
# App Service sets these automatically via app_settings in Terraform

COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=employeedb
COSMOS_CONTAINER=employees

# Local dev: ensure you are logged in with `az login` so DefaultAzureCredential
# picks up your Azure CLI credentials.
# Your Azure AD user needs the Cosmos DB Built-in Data Contributor role assigned
# on the Cosmos DB account (see root main.tf for the App Service role assignment).

PORT=8080
NODE_ENV=development
